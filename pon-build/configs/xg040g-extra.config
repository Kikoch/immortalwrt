# ============================================================
# XG-040G-MD 附加包 —— 对齐 Kikoch/Openwrt-Actions 的 ponwrt-extra.config
#   参考: https://github.com/Kikoch/Openwrt-Actions/blob/main/ponwrt-extra.config
#
# 为什么选 ponwrt-extra 而不是 onu-extra:
#   本仓库 (Kikoch/immortalwrt @ pon-xg040g-inline) 用的是 pbs05 的
#   luci-app-pon + luci-app-iptv, 与 ponwrt 线同款; onu 线换成了
#   luci-app-onu (IPTV 页被吸收, 独立包不存在), 包名对不上。
#
# 用法: cp configs/xg040g.config .config
#       cat configs/xg040g-extra.config >> .config
#       make defconfig
#
# 规则: 同名符号取最后一条 -> 本文件可以反向覆盖种子里的 =y / =n。
#   "is not set" 必须写成注释行, 不能删掉 —— 删掉等于没覆盖。
#
# 与上一版"大杂烩"的差异: 移除 samba4 / ttyd / upnp / USB 打印机 /
#   ntfs3 / smartdns / xray-core / zerotier / vlmcsd / ddns-go / udpxy /
#   igmpproxy / socat / jq / cpufreq / default-settings* —— 参考线明确不带这些。
# ============================================================

# ---------- LuCI 中文 + 主题 ----------
# 打开总开关后, 已启用应用的 luci-i18n-*-zh-cn 会自动默认 =y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# 种子 xg040g.config 里 argon 与 bootstrap 同时 =y, 这里反向覆盖。
# ⚠️ 必须连 argon-config 一起关: luci-app-argon-config 的 LUCI_DEPENDS
#    含 +luci-theme-argon, kconfig 的 select 优先级高于 "is not set",
#    只关 theme 会被 select 拉回来 (见 Openwrt-Actions onu 线实测)。
# CONFIG_PACKAGE_luci-app-argon-config is not set
# CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-footstrap is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-theme-openwrt is not set
# CONFIG_PACKAGE_luci-theme-openwrt-2020 is not set

# ---------- LuCI 组件 (对齐 18.1) ----------
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-lib-uqr=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_coreutils-nohup=y

# ---------- OpenClash ----------
# ⚠️ 只在 luci feed pin 到 ed0441b1 (2026-10-02 merge) 或之后才存在;
#    pin 早了写 =y 会被 defconfig 静默删符号 -> 编译绿、固件没有。
#    pon-build/feeds.conf 已 pin 在 ed0441b1。
CONFIG_PACKAGE_luci-app-openclash=y
# 中文是 po2lmo 直接编进包体的, 上游没有 luci-i18n-openclash-zh-cn 这个包,
# 别写 (写了只会被静默删)。
# 运行时依赖显式化, 防上游改 DEPENDS 后悄悄少东西:
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
# ruby + ruby-yaml 读 YAML 配置 (OpenClash 脚本实测引用 ruby)
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y

# ---------- DDNS (dnspod) ----------
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# ---------- WireGuard ----------
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-udptunnel4=y
CONFIG_PACKAGE_kmod-udptunnel6=y
# 无 po/ 目录 -> 上游没有 luci-i18n-wireguard-zh-cn, 不写。

# ---------- zram: 小内存设备 OOM 兜底 ----------
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-lz4=y
# kmod-lib-lzo-rle 在部分 fork 已随新内核的 KERNEL_ZRAM_BACKEND_* 消失,
# 不写 (写了只会被静默删符号, 徒增噪音)。

# ---------- PON 全栈 (种子已开, 显式再写一遍防基线回退) ----------
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-pon-debug=y
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y
CONFIG_PACKAGE_luci-app-iptv=y
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
# USB 5V regulator (DTS regulator-output 节点所需)
CONFIG_PACKAGE_kmod-regulator-userspace-consumer=y

# ---------- 网络 / 工具 ----------
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-mppe=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_shellsync=y
# 最后三个是 ppp 的硬依赖, select 压过 "is not set", 关不掉;
# 显式 =y 只是让断言能对上, 见 Openwrt-Actions ponwrt-extra.config 的链路分析。

# ---------- USB / 文件系统 (设备无外置 USB 口, 按参考线保留) ----------
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_uboot-envtools=y

# ---------- 明确关掉 ----------
# UPnP: 官方 release.config 会强制带, 这里反向覆盖 (一起写)。
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-i18n-upnp-zh-cn is not set
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# CONFIG_PACKAGE_miniupnpd-iptables is not set
# adblock-fast 全家 (含前端 select 回来的后端与中文包):
# CONFIG_PACKAGE_luci-app-adblock-fast is not set
# CONFIG_PACKAGE_adblock-fast is not set
# CONFIG_PACKAGE_luci-i18n-adblock-fast-zh-cn is not set
# CONFIG_PACKAGE_gawk is not set
# CONFIG_PACKAGE_grep is not set
# CONFIG_PACKAGE_sed is not set
# CONFIG_PACKAGE_coreutils-sort is not set
# yq: Go 包, bootstrap 整套 Go 工具链且缓存残缺时必挂, 参考线已移除。
# CONFIG_PACKAGE_yq is not set

# ---------- 编译选项 ----------
# 种子里是 CONFIG_DEVEL=n, CCACHE 依赖 DEVEL, 必须一起开。
CONFIG_DEVEL=y
CONFIG_CCACHE=y
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
