# ImmortalWrt + 内置 PON —— Nokia XG-040G-MD (UBI) 配置种子
#
# 用法: cp configs/xg040g.config .config && make defconfig
#   这是一个"种子", 不是展开后的完整 .config —— make defconfig 会补齐依赖。
#   想加家用软件 (openclash / samba / 打印 / 无线) 就再追加 configs/xg040g-extra.config。
#
# 已知会静默丢失的坑: make defconfig 对不存在的 CONFIG_PACKAGE_xxx 符号的处理就是
#   —— 默默删掉那一行, 编译照 green, 固件里就是没有。所以 scripts/check-config.sh
#   在 defconfig 之后对关键包做了硬断言。

# ---------- 目标 ----------
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
# 必须开 MULTI_PROFILE: scripts/target-metadata.pl 里
#   menu "Target Devices" depends on TARGET_MULTI_PROFILE
# 关掉它, TARGET_DEVICE_* 会被 kconfig 整组裁掉, 结果就是 run #5 的现象 ——
# make world 编完内核和全部包 (44 分钟) 却一个镜像都不产出。
# 已验证写法来自 pbs05/ponwrt 的 configs/an7581.config。
CONFIG_TARGET_MULTI_PROFILE=y
# CONFIG_TARGET_ALL_PROFILES is not set
# 对齐 pbs05/ponwrt 已验证配置: 必须开 PER_DEVICE_ROOTFS, 否则 an7581 这类
# 需要 per-device 打包的 target 在 make world 的 image 阶段会早失败 (run #7 实测:
# 编译步骤被管道掩盖显示 success, 实则 image 构建没跑完, 一个 .itb 都没产出)。
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
# CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi is not set
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y
CONFIG_TARGET_DEVICE_PACKAGES_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=""
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y

# ---------- 包管理 / 镜像 ----------
CONFIG_USE_APK=y
CONFIG_SIGNED_PACKAGES=n
# fitblk: rootfs 以 FIT 载荷形式落进 UBI 卷, 配合 DTB 里的 ubi.fm_autoconvert=1。
# 注意该包 Makefile 设了 HIDDEN:=1 (menuconfig 不可见, 也不能在 .config 里硬 =y),
# 它由 nokia_xg-040g-md-ubi 的 DEVICE_PACKAGES += fitblk 自动注入固件。这里用
# =m + MODULE_DEFAULT 确保它被构建 (对齐 pbs05/ponwrt 已验证配置; 硬 =y 会被
# defconfig 当成无效符号 silent drop, 之前所有 run 的固件其实都没带 fitblk)。
CONFIG_PACKAGE_fitblk=m
CONFIG_MODULE_DEFAULT_fitblk=y
CONFIG_PACKAGE_fit-check-sign=y
CONFIG_PACKAGE_fwtool=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_uboot-envtools=y

# ---------- PON (源码已并入 package/airoha-pon, 不再走 feed) ----------
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
# XG-040G-MD 用的是 EN7572; paged-bosa 是 GN28L95/UX3363 前端, 别选
# CONFIG_PACKAGE_kmod-airoha-paged-bosa is not set
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-pon-debug=y
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y
CONFIG_PACKAGE_luci-app-iptv=y
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y

# ---------- 本机硬件 ----------
# EN8811H = lan1 的 2.5G PHY。上游 an7581-nokia_xg-040g-md-common.dtsi 已是
# reset-assert-us <10000> / reset-deassert-us <20000> (修好的值), 别再改回 1s/100ms。
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-hwmon-nct7802=y
CONFIG_PACKAGE_kmod-i2c-core=y
CONFIG_PACKAGE_i2c-tools=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y

# ---------- 网络基座 ----------
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-slhc=y
CONFIG_PACKAGE_kmod-mppe=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-udptunnel4=y
CONFIG_PACKAGE_kmod-udptunnel6=y

# ---------- 文件系统 / 存储 ----------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_e2fsprogs=y

# ---------- LuCI ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_cgi-io=y

# ---------- 诊断 ----------
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y

# ---------- 构建选项 ----------
CONFIG_CCACHE=y
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_KERNEL=n
CONFIG_DEVEL=n
# 版本串: 让固件自己能认出是谁编的、哪一天、哪个提交 (scripts/set-build-version.sh 会写)
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ImmortalWrt PON"
CONFIG_VERSION_FILENAMES=y
